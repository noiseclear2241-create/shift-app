{
  "name": "shift-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "node --experimental-strip-types --test src/lib/schedule.test.ts src/lib/notifications.test.ts src/lib/ads.test.ts",
    "dev:emulator": "firebase emulators:exec --only auth,firestore --project demo-shift \"next dev -p 3002\"",
    "test:rules": "firebase emulators:exec --only firestore --project demo-shift \"node --test tests/rules.test.mjs\""
  },
  "dependencies": {
    "firebase": "11.6.0",
    "firebase-admin": "13.9.0",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "4.0.1",
    "@types/node": "20.17.30",
    "@types/react": "18.3.20",
    "@types/react-dom": "18.3.6",
    "firebase-tools": "14.27.0",
    "typescript": "5.6.3"
  }
}
