# Firebaseコンソール →「プロジェクトの設定」→「マイアプリ（ウェブ）」の値を貼り付けます。
# このファイルを .env.local という名前でコピーして使います（.env.local はGitに入りません）。
# 値が空のままだと「お試しモード」（このブラウザ内だけに保存）で動きます。
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# プッシュ通知：Firebaseコンソール →「プロジェクトの設定」→「Cloud Messaging」→「ウェブプッシュ証明書」の鍵ペア（公開してよい値）
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# プッシュ通知の送信（サーバー専用・秘密情報）：サービスアカウントの秘密鍵 JSON の中身をそのまま入れる。
# Vercel には種類「シークレット」で登録する。チャットやGitには絶対に載せない。
FIREBASE_SERVICE_ACCOUNT=

# 毎朝の自動送信の合言葉（サーバー専用・秘密情報）。16文字以上のランダムな文字列。
# Vercel の定時実行がこの値を付けて呼び出すので、外部から勝手に実行されない。
CRON_SECRET=

# 運営者（広告の管理画面を使える人）のメールアドレス。複数ならカンマ区切り。
# Google でログインしたアカウント（メールアドレスが確認済み）だけが運営者になれる。
ADMIN_EMAILS=
